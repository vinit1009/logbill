# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox), with the Invoicing feature ticked
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# The sandbox business account the app belongs to (Testing Tools > Sandbox Accounts)
PAYPAL_INVOICER_EMAIL=

# Any OpenAI-compatible chat API; OpenRouter by default
AI_API_KEY=
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=anthropic/claude-haiku-5.5
# AI_DAILY_LIMIT=400

# Email domains invoices may be sent to (sandbox accounts use example.com)
# RECIPIENT_DOMAINS=example.com
# PORT=8787
